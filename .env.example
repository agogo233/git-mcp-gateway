# 复制为 .env（chmod 600，勿提交）。主密钥生成：openssl rand -base64 32
GIT_MCP_MASTER_KEY=REPLACE_WITH_BASE64_32B
# 持久工作区根目录（宿主机绝对路径，须与 config/repos.yaml 的 workspace_root 一致）
WORKSPACE_ROOT=/srv/workspaces
# 宿主机 docker 组 gid（stat -c %g /var/run/docker.sock）
DOCKER_GID=999
# gateway 监听绑定的宿主机地址。默认只绑本机回环；容器间经 opencode-net
# 直连不受影响。如需局域网访问请改为内网 IP，公网暴露必须加 TLS 反代。
GATEWAY_ADDR=127.0.0.1
